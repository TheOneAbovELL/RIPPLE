{"nodes": [{"id": "docs_adr_0015_change_is_memory_write_self_expiry_decision", "label": "ADR-0015: Every change is a memory write; temporary facts self-expire", "file_type": "rationale", "source_file": "docs/adr/0015-change-is-memory-write-self-expiry.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Data model lacked an entity for ripple trigger and a place to store temporariness (FR-5). Trigger of every ripple is a memory write (new, new version incl. user edit, or expiry); temporary fact is an ordinary memory with valid_to; ChangeEvent gains trigger_kind; retrieval treats PENDING_USER like SUSPECT. Points 1-2 decided in kickoff; 3-4 are collaborator's recommended option, open to reversal.", "tradeoffs": "Rejected separate ChangeRequest entity, polymorphic ChangeEvent.trigger, classifying temporary only in detector without valid_to. Cost: FakeClock scenario for FR-5; one I2 invariant test per trigger kind; sweep needs index on valid_to.", "status": "Accepted", "date": "2026-10-19", "revisit_if": "Author answers question 5 differently (supersede points 3-4), or expiry ripples prove noisy because detector fills valid_to badly", "_origin": "semantic"}, {"id": "docs_adr_0015_change_is_memory_write_self_expiry_valid_to", "label": "valid_to field", "file_type": "concept", "source_file": "docs/adr/0015-change-is-memory-write-self-expiry.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Marks temporary facts; the nightly sweep retires memories whose valid_to has passed and ripples expiry deterministically.", "_origin": "semantic"}, {"id": "docs_adr_0015_change_is_memory_write_self_expiry_trigger_kind", "label": "ChangeEvent.trigger_kind", "file_type": "concept", "source_file": "docs/adr/0015-change-is-memory-write-self-expiry.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ripple | expiry | user_edit | user_answer.", "_origin": "semantic"}, {"id": "docs_adr_0015_change_is_memory_write_self_expiry_forgetevent", "label": "ForgetEvent", "file_type": "concept", "source_file": "docs/adr/0015-change-is-memory-write-self-expiry.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Forget is a deletion logged as ForgetEvent, not a ChangeEvent.", "_origin": "semantic"}, {"id": "docs_adr_0015_change_is_memory_write_self_expiry_fakeclock", "label": "FakeClock scenario", "file_type": "concept", "source_file": "docs/adr/0015-change-is-memory-write-self-expiry.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Test approach for FR-5: ripple in, expire, ripple out.", "_origin": "semantic"}], "edges": [{"source": "docs_adr_0015_change_is_memory_write_self_expiry_decision", "target": "docs_adr_0015_change_is_memory_write_self_expiry_valid_to", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0015-change-is-memory-write-self-expiry.md", "source_location": null, "weight": 1.0, "_origin": "semantic"}, {"source": "docs_adr_0015_change_is_memory_write_self_expiry_decision", "target": "docs_adr_0015_change_is_memory_write_self_expiry_trigger_kind", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0015-change-is-memory-write-self-expiry.md", "source_location": null, "weight": 1.0, "_origin": "semantic"}, {"source": "docs_adr_0015_change_is_memory_write_self_expiry_decision", "target": "docs_adr_0015_change_is_memory_write_self_expiry_forgetevent", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0015-change-is-memory-write-self-expiry.md", "source_location": null, "weight": 1.0, "_origin": "semantic"}, {"source": "docs_adr_0015_change_is_memory_wr