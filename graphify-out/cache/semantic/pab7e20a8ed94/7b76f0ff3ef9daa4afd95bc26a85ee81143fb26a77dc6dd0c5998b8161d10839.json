{"nodes": [{"id": "docs_adr_0027_anthropic_first_provider_adapter_decision", "label": "ADR-0027: Anthropic SDK as the first provider adapter; structured output via forced tool use", "file_type": "rationale", "source_file": "docs/adr/0027-anthropic-first-provider-adapter.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ADR-0010's Router had no real provider; product unusable without one. anthropic SDK pinned; ripple.llm.providers.anthropic.AnthropicClient is first LLMClient; structured output by declaring one tool with input_schema = requested JSON schema and forcing tool_choice; Router still validates (I4). Model ids from RouterConfig; prices in config so cost_usd is None when unpriced (I8); Router retries transport errors with exponential backoff before fallback.", "tradeoffs": "Rejected provider-native JSON mode (not uniform), LangChain wrappers (extra layer over Router), OpenAI first (keys and examples Anthropic-first). Cost: tests mock SDK client; adapter only module importing anthropic; OpenAI adapter unbuilt.", "status": "Accepted (autonomous mandate)", "date": "2026-10-19", "revisit_if": "SDK tool-use contract changes or measured costs argue for different defaults", "_origin": "semantic"}, {"id": "docs_adr_0027_anthropic_first_provider_adapter_anthropic_sdk", "label": "anthropic SDK", "file_type": "concept", "source_file": "docs/adr/0027-anthropic-first-provider-adapter.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Provider SDK.", "_origin": "semantic"}, {"id": "docs_adr_0027_anthropic_first_provider_adapter_anthropicclient", "label": "AnthropicClient (ripple.llm.providers.anthropic)", "file_type": "concept", "source_file": "docs/adr/0027-anthropic-first-provider-adapter.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "First LLMClient implem