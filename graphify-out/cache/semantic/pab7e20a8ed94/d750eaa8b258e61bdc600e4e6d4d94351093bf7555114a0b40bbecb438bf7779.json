{"nodes": [{"id": "docs_adr_0035_parser_post_validation_policy_decision", "label": "ADR-0035 Parsers: LLM extraction with deterministic span, value and date validation", "file_type": "rationale", "source_file": "docs/adr/0035-parser-post-validation-policy.md", "rationale": "A model can satisfy the schema yet misquote, round numbers or emit unusable dates; FR-2 requires every field link to a source span, I4 schema validation, I5 no invention.", "tradeoffs": "Recall traded for precision: misquoted fields, year-less deadlines and out-of-scale numbers are dropped not guessed; confidence 0.5/0.6 are policy constants; 4-point GPA silently accepted.", "_origin": "semantic"}, {"id": "docs_adr_0035_parser_post_validation_policy_model_quotes_code_locates", "label": "Model quotes, code locates (locate_span)", "file_type": "concept", "source_file": "docs/adr/0035-parser-post-validation-policy.md", "rationale": "Models count characters badly; a wrong offset is undetectable, a wrong quote is. Unfound quote drops the item, no retry.", "_origin": "semantic"}, {"id": "docs_adr_0035_parser_post_validation_policy_deadline_normaliser", "label": "Hand-written deadline normaliser (dates.normalise_deadline)", "file_type": "concept", "source_file": "docs/adr/0035-parser-post-validation-policy.md", "rationale": "ISO 8601 with offset from located span; year-less dates dropped; day-first numeric dates; no date library because fuzzy mode guesses years.", "_origin": "semantic"}, {"id": "docs_adr_0035_parser_post_validation_policy_regex_cross_check", "label": "Regex cross-checks for cgpa_cutoff and deadline", "file_type": "concept", "source_file": "docs/adr/0035-parser-post-validation-policy.md", "rationale": "Second opinion: disagreement caps model field at 0.5, missed value added at 0.6; regexes written not to invent.", "_origin": "semantic"}, {"id": "docs_adr_0035_parser_post_validation_policy_email_envelope_strip", "label": "Forwarded email envelope stripping (strip_email_envelope)", "file_type": "concept", "source_file": "docs/adr/0035-parser-post-validation-policy.md", "rationale": "Deterministic removal of headers, quote prefixes, disclaimers and signatures before parsing; spans are offsets into stripped text.", "_origin": "semantic"}, {"id": "invariant_i5_no_invented_facts", "label": "Invariant I5: agent never invents facts or numbers", "file_type": "concept", "source_file": "docs/adr/0035-parser-post-validation-policy.md", "_origin": "semantic"}], "edges": [{"source": "docs_adr_0035_parser_post_validation_policy_decision", "target": "docs_adr_0035_parser_post_validation_policy_model_quotes_code_locates", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0035-parser-post-validation-policy.md", "_origin": "semantic"}, {"source": "docs_adr_0035_parser_post_validation_policy_decision", "target": "docs_adr_0035_parser_post_validation_policy_deadline_normaliser", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0035-parser-post-validation-policy.md", "_origin": "semantic"}, {"source": "docs_adr_0035_parser_post_validation_policy_decision", "target": "docs_adr_0035_parser_post_validation_policy_regex_cross_check", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0035-parser-post-validation-policy.md", "_origin": "semantic"}, {"source": "docs_adr_0035_parser_post_validation_policy_decision", "target": "docs_adr_0035_parser_post_validation_policy_email_envelope_strip", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0035-parser-post-validation-policy.md", "_origin": "semantic"}, {"source": "docs_adr_0035_parser_post_validation_policy_decision", "target": "src_ripple_domains_jobs_parsers_jd", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/a