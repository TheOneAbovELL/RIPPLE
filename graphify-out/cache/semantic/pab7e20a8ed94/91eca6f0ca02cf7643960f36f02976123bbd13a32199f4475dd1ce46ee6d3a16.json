{"nodes": [{"id": "docs_adr_0010_llm_router_decision", "label": "ADR-0010: Provider-agnostic LLM router with structured outputs", "file_type": "rationale", "source_file": "docs/adr/0010-llm-router.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Many components call LLMs; need reliability, testability, reproducible evals. All LLM calls go through ripple.llm.Router: per-task model from config, JSON-schema outputs validated by Pydantic (I4), retries with backoff, provider fallback, cost/latency logging, model versions pinned per eval run.", "tradeoffs": "Rejected direct SDK calls everywhere (untestable, no single place for retries/logging). Cost: one choke point to maintain; offline tests easy.", "status": "Accepted", "date": "2026-10-19", "revisit_if": "A provider feature we need cannot pass through the router", "_origin": "semantic"}, {"id": "docs_adr_0010_llm_router_router", "label": "ripple.llm.Router", "file_type": "concept", "source_file": "docs/adr/0010-llm-router.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Single choke point for all LLM calls.", "_origin": "semantic"}, {"id": "docs_adr_0010_llm_router_fakellm", "label": "FakeLLM", "file_type": "concept", "source_file": "docs/adr/0010-llm-router.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Implements the same interface as real clients for offline tests.", "_origin": "semantic"}, {"id": "docs_adr_0010_llm_router_pydantic_validation", "label": "Pydantic schema validation", "file_type": "concept", "source_file": "docs/adr/0010-llm-router.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Validates JSON-schema outputs.", "_origin": "semantic"}, {"id": "docs_adr_0010_llm_router_invariant_i4", "label": "Invariant I4: LLM outputs schema-validated by Router", "file_type": "concept", "source_file": "docs/adr/0010-llm-router.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No unvalidated LLM output enters the system.", "_origin": "semantic"}], "edges": [{"source": "docs_adr_0010_llm_router_decision", "target": "docs_adr_0010_llm_router_router", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0010-llm-router.md", "source_location": null, "weight": 1.0, "_origin": "semantic"}, {"source": "docs_adr_0010_llm_router_decision", "target": "docs_adr_0010_llm_router_fakellm", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0010-llm-router.md", "source_location": null, "weight": 1.0, "_origin": "semantic"}, {"source": "docs_adr_0010_llm_router_decision", "target": "docs_adr_0010_llm_router_pydantic_validation", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0010-llm-router.md", "source_location": null, "weight": 1.0, "_origin": "semantic"}, {"source": "docs_adr_0010_llm_router_decision", "target": "docs_adr_0010_llm_router_invariant_i4", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0010-llm-router.md", "source_location": null, "weight": 1.0, "_origin": "semantic"}, {"source": "docs_adr_0010_llm_router_router", "target": "docs_adr_0010_llm_router_pydantic_validation", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0010-llm-router.md", "source_location": null, "weight": 1.0, "_origin": "semantic"}, {"source": "docs_adr_0010_llm_router_fakellm", "target": "docs_adr_0010_llm_router_router", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0010-llm-router.md", "source_location": null, "weight": 1.0, "