{"nodes": [{"id": "docs_adr_0021_pyyaml_for_scenarios_decision", "label": "ADR-0021: Scenario files are YAML, parsed with PyYAML", "file_type": "rationale", "source_file": "docs/adr/0021-pyyaml-for-scenarios.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Scenario tests are tests/scenarios/<name>.yaml (initial memories, ordered events, expected states); the bench smoke suite replays the same files; stdlib has no YAML parser. Add pyyaml (exact pin) and types-pyyaml; only yaml.safe_load.", "tradeoffs": "Rejected JSON (no comments, noisy), TOML (awkward for ordered nested events), ruamel.yaml (round-trip unneeded). Cost: one small dependency; scenario schema validated into Pydantic models so typos fail loudly.", "status": "Accepted (autonomous mandate)", "date": "2026-10-19", "revisit_if": "Scenario files need generation at scale (Phase 3/4); Python builder may replace hand-written YAML", "_origin": "semantic"}, {"id": "docs_adr_0021_pyyaml_for_scenarios_pyyaml", "label": "PyYAML (safe_load)", "file_type": "concept", "source_file": "docs/adr/0021-pyyaml-for-scenarios.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "YAML scenario loader.", "_origin": "semantic"}, {"id": "docs_adr_0021_pyyaml_for_scenarios_scenario_files", "label": "Scenario YAML files (tests/scenarios)", "file_type": "concept", "source_file": "docs/adr/0021-pyyaml-for-scenarios.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Shared by tests and bench.", "_origin": "semantic"}], "edges": [{"source": "docs_adr_0021_pyyaml_for_scenarios_decision", "target": "docs_adr_0021_pyyaml_for_scenarios_pyyaml", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0021-pyyaml-for-scenarios.md", "source_location": null, "weight": 1.0, "_origin": "seman