{"nodes": [{"id": "docs_adr_0020_change_detection_policy_decision", "label": "ADR-0020: Change detection: deterministic for structured facts, LLM for prose", "file_type": "rationale", "source_file": "docs/adr/0020-change-detection-policy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "FR-5 needs to detect new/replace/temporary; an LLM call per statement is expensive and non-deterministic where mechanical. Intake classifies in two stages: deterministic structured subject+attribute match is an update; LLM (change_detector.v1) for prose returns new|update(id)|temporary(valid_to) via validated schema given current date. Prompt prefers 'new' when unsure because wrong update rewrites history.", "tradeoffs": "Rejected LLM-for-everything (cost, determinism), rules-for-everything (cannot read prose), embedding similarity to find memory (kept as possible pre-filter in Phase 3). Cost: temporary statements coexist with permanent memories and expire.", "status": "Accepted (autonomous mandate)", "date": "2026-10-19", "revisit_if": "Stage 1 produces wrong updates across domains, arguing for domain-scoped attribute namespaces", "_origin": "semantic"}, {"id": "docs_adr_0020_change_detection_policy_intake", "label": "ripple.core.intake", "file_type": "concept", "source_file": "docs/adr/0020-change-detection-policy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two-stage classifier of incoming statements.", "_origin": "semantic"}, {"id": "docs_adr_0020_change_detection_policy_change_detector", "label": "ripple.llm.change_detector (prompt change_detector.v1)", "file_type": "concept", "source_file": "docs/adr/0020-change-detection-policy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "LLM stage for prose.", "_origin": "semantic"}], "edges": [{"source": "docs_adr_0020_