{"nodes": [{"id": "docs_adr_0009_trained_link_finder_decision", "label": "ADR-0009: A trained small model for link finding", "file_type": "rationale", "source_file": "docs/adr/0009-trained-link-finder.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Inferring dependency links is open (C1) and LLM linking on every write is expensive. Three linkers behind one interface: rules (baseline), LLM, trained small encoder pair classifier; trained model default if it meets H3.", "tradeoffs": "Rejected LLM only (cost per write), rules only (low recall on hidden links), embedding similarity (measures similarity not dependency). Cost: needs labelled data (synthetic, hand-checked, pilot corrections).", "status": "Accepted", "date": "2026-10-19", "revisit_if": "Trained model misses H3 by a wide margin after two training rounds", "_origin": "semantic"}, {"id": "docs_adr_0009_trained_link_finder_linker", "label": "Linker interface (rules, LLM, trained)", "file_type": "concept", "source_file": "docs/adr/0009-trained-link-finder.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One interface, three interchangeable implementations.", "_origin": "semantic"}, {"id": "docs_adr_0009_trained_link_finder_modernbert_deberta", "label": "ModernBERT / DeBERTa-v3 pair classifier", "file_type": "concept", "source_file": "docs/adr/0009-trained-link-finder.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Small encoder fine-tuned to predict dependency between memory pairs.", "_origin": "semantic"}, {"id": "docs_adr_0009_trained_link_finder_hypothesis_h3", "label": "Hypothesis H3 (trained linker quality)", "file_type": "concept", "source_file": "docs/adr/0009-trained-link-finder.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "ra