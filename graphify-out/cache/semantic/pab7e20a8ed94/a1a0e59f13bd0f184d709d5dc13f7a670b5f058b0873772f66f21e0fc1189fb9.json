{"nodes": [{"id": "docs_adr_0013_wave_by_wave_ripple_link_classes_decision", "label": "ADR-0013: Wave-by-wave ripple over core link classes", "file_type": "rationale", "source_file": "docs/adr/0013-wave-by-wave-ripple-link-classes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Graph decides scope, LLM decides action; need chains of 3+ hops and a link class that never propagates. Engine emits waves along depends_on links; each wave commits as one transaction; keep halts a branch; ask parks memory in PENDING_USER and marks subtree SUSPECT; two link classes (depends_on, snapshot_of) in core; engine never calls an LLM (I3). Decided in kickoff interview; transaction boundary and two-class reduction from architecture-guardian review.", "tradeoffs": "Rejected full transitive closure first (more LLM cost and over-correction), one transaction per ripple (impossible with LLM/user waits; hides SUSPECT from retrieval), per-link-type policy registry (testability), separate depends_on/derived_from classes, fixed generic types only (loses typed signal for link finder). Cost: latency grows with chain depth; wrong keep stops propagation; whole subtree SUSPECT while ask pending; crash leaves open ChangeEvent resumed by nightly sweep.", "status": "Accepted (approved by author same day); amends ADR-0003, ADR-0004, wording of ADR-0007/I7", "date": "2026-10-19", "revisit_if": "RippleBench chain scenarios show closure-first catches dependents the wave approach misses, or a domain needs behaviour neither class expresses", "_origin": "semantic"}, {"id": "docs_adr_0013_wave_by_wave_ripple_link_classes_ripple_engine", "label": "Ripple engine (wave iterator)", "file_type": "concept", "source_file": "docs/adr/0013-wave-by-wave-ripple-link-classes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Iterator: takes decisions in, gives next wave out; cycle safety via visited set, depth limit; never calls an LLM.", "_origin": "semantic"}, {"id": "docs_adr_0013_wave_by_wave_ripple_link_classes_depends_on", "label": "depends_on link class", "file_type": "concept", "source_file": "docs/adr/0013-wave-by-wave-ripple-link-classes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Propagates, copied on update, forget cascades.", "_origin": "semantic"}, {"id": "docs_adr_0013_wave_by_wave_ripple_link_classes_snapshot_of", "label": "snapshot_of link class", "file_type": "concept", "source_file": "docs/adr/0013-wave-by-wave-ripple-link-classes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Never propagates, never copied; forget removes the link.", "_origin": "semantic"}, {"id": "docs_adr_0013_wave_by_wave_ripple_link_classes_resolver", "label": "Resolver", "file_type": "concept", "source_file": "docs/adr/0013-wave-by-wave-ripple-link-classes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Decides keep/update/retire/ask per affected memory per wave.", "_origin": "semantic"}, {"id": "docs_adr_0013_wave_by_wave_ripple_link_classes_suspect_status", "label": "SUSPECT status", "file_type": "concept", "source_file": "docs/adr/0013-wave-by-wave-ripple-link-classes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dependents are marked SUSPECT and committed so retrieval can flag them.", "_origin": "semantic"}, {"id": "docs_adr_0013_wave_by_wave_ripple_link_classes_pending_user_status", "label": "PENDING_USER status", "file_type": "concept", "source_file": "docs/adr/0013-wave-by-wave-ripple-link-classes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Parks a memory awaiting a user answer.", "_origin": "semantic"}, {"id": "docs_adr_0013_wave_by_wave_ripple_link_classes_invariant_i3", "label": "Invariant I3: engine never calls an LLM", "file_type": "concept", "source_file": "docs/adr/0013-wave-by-wave-ripple-link-classes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Graph decides scope, LLM only decides action in Resolver.", "_origin": "semantic"}, {"id": "docs_adr_0013_wave_by_wave_ripple_link_classes_invariant_i1", "label": "Invariant I1: retrieval flags SUSPECT memories", "file_type": "concept", "source_file": "docs/adr/0013-wave-by-wave-ripple-link-classes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Unresolved memories returned only with a flag.", "_origin": "semantic"}, {"id": "docs_adr_0013_wave_by_wave_ripple_link_classes_domain_adapter_mapping", "label": "Domain-adapter link-type mapping", "file_type": "concept", "source_file": "docs/adr/0013-wave-by-wave-ripple-link-classes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Maps every domain link type to exactly one core class; core validates only the class.", "_origin": "semantic"}, {"id": "docs_adr_0013_wave_by_wave_ripple_link_classes_nightly_sweep", "label": "Nightly sweep (Curator)", "file_type": "concept", "source_file": "docs/adr/0013-wave-by-wave-ripple-link-classes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Resumes open ChangeEvents older than a configurable age.", "_origin": "semantic"}], "edges": [{"source": "docs_adr_0013_wave_by_wave_ripple_link_classes_decision", "target": "docs_adr_0013_wave_by_wave_ripple_link_classes_ripple_engine", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0013-wave-by-wave-ripple-link-clas