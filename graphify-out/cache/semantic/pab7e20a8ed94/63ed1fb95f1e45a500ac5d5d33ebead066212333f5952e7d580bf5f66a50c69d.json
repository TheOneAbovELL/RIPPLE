{"nodes": [{"id": "docs_00_vision_ripple", "label": "Ripple (system)", "file_type": "concept", "source_file": "docs/00-vision.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keeps an AI agent's knowledge correct as the world changes: when one fact changes, every belief that depended on it is updated.", "_origin": "semantic"}, {"id": "docs_00_vision_stale_dependent_knowledge_problem", "label": "Problem: agents act on stale dependent knowledge", "file_type": "concept", "source_file": "docs/00-vision.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The worst failure of long-running agents is not forgetting but acting confidently on stale knowledge. Current memory systems update the contradicted fact (e.g. CGPA) but leave dependents (eligibility, recommendations, search criteria) stale.", "_origin": "semantic"}, {"id": "docs_00_vision_thesis", "label": "Thesis: explicit dependencies; code decides WHICH, LLM decides HOW", "file_type": "concept", "source_file": "docs/00-vision.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Make dependencies between memories explicit; deterministic code determines the affected set, the LLM only decides the fix per memory.", "_origin": "semantic"}, {"id": "docs_00_vision_c1_learned_dependency_induction", "label": "C1 Learned dependency induction", "file_type": "concept", "source_file": "docs/00-vision.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A small trained model infers typed links between memories from raw text; PACMI and rollback repair assume links are given.", "_origin": "semantic"}, {"id": "docs_00_vision_c2_action_level_evaluation", "label": "C2 Action-level evaluation", "file_type": "concept", "source_file": "docs/00-vision.md", "source