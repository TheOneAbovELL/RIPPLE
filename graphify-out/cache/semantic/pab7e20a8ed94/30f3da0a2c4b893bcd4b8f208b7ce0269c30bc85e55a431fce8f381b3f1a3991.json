{"nodes": [{"id": "docs_adr_0024_resume_pdf_parsing_decision", "label": "ADR-0024: Resume parsing: pypdf text extraction, LLM structuring, user confirmation", "file_type": "rationale", "source_file": "docs/adr/0024-resume-pdf-parsing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "FR-1 parses uploaded PDF resumes into profile facts confirmed one by one; I5 nothing stored without confirmation. pypdf extracts text; LLM structures into validated schema (ripple.llm.schemas.resume) with text spans; candidate facts held outside the memory store until confirmed, then become memories through ripple.core.intake. Scanned PDFs reported unparseable; no OCR.", "tradeoffs": "Rejected pdfminer.six/PyMuPDF (heavier), LLM vision on PDF (vendor-specific, costly), storing candidates as PENDING_USER memories (PENDING_USER means was valid; unconfirmed was never valid). Cost: one small dependency; confirmation flow belongs to API workstream.", "status": "Accepted (autonomous mandate)", "date": "2026-10-19", "revisit_if": "Pilot resumes are mostly scanned images, justifying OCR", "_origin": "semantic"}, {"id": "docs_adr_0024_resume_pdf_parsing_pypdf", "label": "pypdf", "file_type": "concept", "source_file": "docs/adr/0024-resume-pdf-parsing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pure-Python PDF text extraction.", "_origin": "semantic"}, {"id": "docs_adr_0024_resume_pdf_parsing_resume_schema", "label": "ripple.llm.schemas.resume", "file_type": "concept", "source_file": "docs/adr/0024-resume-pdf-parsing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Validated schema of candidate facts with source spans.", "_origin": "semantic"}, {"id": "docs_adr_0024_resume_pdf_parsing_candidate_facts", "label": "Pending candidate facts", "file_type": "concept", "source_file": "docs/adr/0024-resume-pdf-parsing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Held outside the memory store until user confirmation.", "_origin": "semantic"}, {"id": "docs_adr_0024_resume_pdf_parsing_invariant_i5", "label": "Invariant I5: nothing stored without confirmation", "file_type": "concept", "source_file": "docs/adr/0024-resume-pdf-parsing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Unconfirmed extractions are never memories.", "_origin": "semantic"}], "edges": [{"source": "docs_adr_0024_resume_pdf_parsing_decision", "target": "docs_adr_0024_resume_pdf_parsing_pypdf", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0024-resume-pdf-parsing.md", "source_location": null, "weight": 1.0, "_origin": "semantic"}, {"source": "docs_adr_0024_resume_pdf_parsing_decision", "target": "docs_adr_0024_resume_pdf_parsing_resume_schema", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0024-resume-pdf-parsing.md", "source_location": null, "weight": 1.0, "_origin": "semantic"}, {"source": "docs_adr_0024_resume_pdf_parsing_decision", "target": "docs_adr_0024_resume_pdf_parsing_candidate_facts", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0024-resume-pdf-parsing.md", "source_location": null, "weight": 1.0, "_origin": "semantic"}, {"source": "docs_adr_0024_resume_pdf_parsing_decision", "target": "docs_adr_0024_resume_pdf_parsing_invariant_i5", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0024-resume-pdf-parsing.md", "source_location": null, "weight": 1.0, "_origin": "semantic"}, {"source": "docs_adr_0024_resume_pdf_parsing_candidate_facts", "target": "docs_adr_0024_resume_pdf_parsing_invariant_i5", "relatio