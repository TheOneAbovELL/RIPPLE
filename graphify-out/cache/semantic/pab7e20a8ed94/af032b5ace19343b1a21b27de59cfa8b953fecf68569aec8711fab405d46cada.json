{"nodes": [{"id": "docs_adr_0022_web_api_stack_decision", "label": "ADR-0022: Web API stack: FastAPI, uvicorn, httpx, python-multipart", "file_type": "rationale", "source_file": "docs/adr/0022-web-api-stack.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No ADR pinned server, test client or file uploads (FR-1 resume upload). fastapi with uvicorn ASGI; httpx for test client and outbound client; python-multipart for uploads; all endpoints async; API tests run against in-memory store with FakeLLM.", "tradeoffs": "Rejected Litestar (smaller community), Django REST (sync, heavy), Starlette alone (FastAPI's typed contracts/OpenAPI are the point). Cost: four mainstream dependencies; API layer may import everything, core never imports it.", "status": "Accepted (autonomous mandate)", "date": "2026-10-19", "revisit_if": "OpenAPI generation or multipart handling blocks a requirement", "_origin": "semantic"}, {"id": "docs_adr_0022_web_api_stack_fastapi", "label": "FastAPI", "file_type": "concept", "source_file": "docs/adr/0022-web-api-stack.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Typed contracts and OpenAPI schema from which the dashboard client is generated.", "_origin": "semantic"}, {"id": "docs_adr_0022_web_api_stack_uvicorn", "label": "uvicorn", "file_type": "concept", "source_file": "docs/adr/0022-web-api-stack.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ASGI server.", "_origin": "semantic"}, {"id": "docs_adr_0022_web_api_stack_httpx", "label": "httpx", "file_type": "concept", "source_file": "docs/adr/0022-web-api-stack.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Test client and outbound HTTP client.", "_origin": "semantic"}, {"id": "docs_adr_0022_web_api_stack_pytho