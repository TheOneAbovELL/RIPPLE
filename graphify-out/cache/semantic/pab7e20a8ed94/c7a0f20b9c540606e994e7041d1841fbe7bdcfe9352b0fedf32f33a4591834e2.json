{"nodes": [{"id": "docs_adr_0008_human_applies_allowed_sources_decision", "label": "ADR-0008: The human applies; allowed sources only", "file_type": "rationale", "source_file": "docs/adr/0008-human-applies-allowed-sources.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Auto-applying and scraping sites that forbid automation breaks terms of service and can harm users. Agent never submits applications; Scout uses only sources whose terms permit automation plus user-forwarded content; registry records terms; robots.txt and rate limits respected.", "tradeoffs": "Rejected auto-apply (ToS, quality, ethics) and scraping LinkedIn (forbidden, bans). Cost: smaller coverage, partly offset by forwarding.", "status": "Accepted", "date": "2026-10-19", "revisit_if": "A source offers an official API that permits our use", "_origin": "semantic"}, {"id": "docs_adr_0008_human_applies_allowed_sources_invariant_i6", "label": "Invariant I6: agent never submits applications", "file_type": "concept", "source_file": "docs/adr/0008-human-applies-allowed-sources.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Human always performs the application step.", "_origin": "semantic"}, {"id": "docs_adr_0008_human_applies_allowed_sources_scout", "label": "Scout", "file_type": "concept", "source_file": "docs/adr/0008-human-applies-allowed-sources.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Discovers openings only from permitted sources and forwarded content.", "_origin": "semantic"}, {"id": "docs_adr_0008_human_applies_allowed_sources_source_registry", "label": "Source registry", "file_type": "concept", "source_file": "docs/adr/0008-human-applies-allowed-sources.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale":