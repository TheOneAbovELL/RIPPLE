{"nodes": [{"id": "docs_adr_0007_retire_not_delete_decision", "label": "ADR-0007: Retire, never silently delete", "file_type": "rationale", "source_file": "docs/adr/0007-retire-not-delete.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Explanations, undo and auditing need history; privacy needs real deletion. State changes keep history via ChangeEvents; hard deletion only through the forget API.", "tradeoffs": "Rejected overwrite in place (no history/undo/explanations) and soft-delete flag only (no reasons, not real deletion). Cost: storage grows, needs retention policy; forget must truly delete per DPDP Act.", "status": "Accepted", "date": "2026-10-19", "revisit_if": "Storage cost becomes a problem in the pilot", "_origin": "semantic"}, {"id": "docs_adr_0007_retire_not_delete_changeevent", "label": "ChangeEvent", "file_type": "concept", "source_file": "docs/adr/0007-retire-not-delete.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Audit/history record of a state change; enables explanations and undo.", "_origin": "semantic"}, {"id": "docs_adr_0007_retire_not_delete_forget_api", "label": "Forget API", "file_type": "concept", "source_file": "docs/adr/0007-retire-not-delete.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only path to hard deletion; cascades along derived_from (later named depends_on) links.", "_origin": "semantic"}, {"id": "docs_adr_0007_retire_not_delete_invariant_i7", "label": "Invariant I7: forget cascades along dependency links", "file_type": "concept", "source_file": "docs/adr/0007-retire-not-delete.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hard deletion cascades so derived values do not survive a forget.", "_origin": "semantic"}, {"id": "docs_adr_00