{"nodes": [{"id": "docs_adr_0018_observability_langfuse_otel_decision", "label": "ADR-0018: Observability with Langfuse over OpenTelemetry; structured logging until then", "file_type": "rationale", "source_file": "docs/adr/0018-observability-langfuse-otel.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "NFR-6 requires every agent step traced with cost and latency; C4 cost claim needs trustworthy numbers. Langfuse (SDK v3 on OpenTelemetry) as tracing backend, added in Phase 2; stdlib structured logging underneath always; eval runs depend on Router usage not Langfuse (I8).", "tradeoffs": "Rejected OTel-only to generic backend (no LLM views; kept open), LangSmith (vendor lock-in, limited free tier), logs only (baseline only). Cost: one more account/service; tracing must never be on critical path.", "status": "Accepted (under author's blanket authorization for Phase 0)", "date": "2026-10-19", "revisit_if": "Langfuse SDK changes break OTel export or self-hosting proves heavy", "_origin": "semantic"}, {"id": "docs_adr_0018_observability_langfuse_otel_langfuse", "label": "Langfuse", "file_type": "concept", "source_file": "docs/adr/0018-observability-langfuse-otel.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "LLM tracing backend with cost dashboards.", "_origin": "semantic"}, {"id": "docs_adr_0018_observability_langfuse_otel_opentelemetry", "label": "OpenTelemetry", "file_type": "concept", "source_file": "docs/adr/0018-observability-langfuse-otel.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Vendor-neutral trace layer underneath Langfuse SDK v3.", "_origin": "semantic"}, {"id": "docs_adr_0018_observability_langfuse_otel_structured_logging", "label": "Structured stdlib logging", "file_type": "concept", "source_file": "docs/adr/0018-observability-langfuse