{"nodes": [{"id": "docs_adr_0014_memory_versions_copy_links_decision", "label": "ADR-0014: Memory versions are rows; dependency links are copied to the new version", "file_type": "rationale", "source_file": "docs/adr/0014-memory-versions-copy-links.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Without copying, dependents' links point at the old row and the graph dies after one ripple. Every version is its own Memory row with supersedes_id; update in one transaction writes new row, retires old, copies incoming and outgoing depends_on links (outgoing re-pointed at parents' latest), leaves snapshot_of on the old row. History links (parent superseded) are skipped by inspector and retrieval expansion. From kickoff interview and architecture-guardian review.", "tradeoffs": "Rejected stable identity with history table (author prefers one table; copy rule gives snapshot semantics free), move/re-point (loses history), leaving outgoing links to Linker only (one missed link detaches version), overwrite in place. Cost: every update is a graph rewrite that must be transactional (NFR-4); link rows grow; in-memory and Postgres stores must share the filter.", "status": "Accepted", "date": "2026-10-19", "revisit_if": "Link-copy bugs appear in pilot or update latency exceeds NFR; then supersede with stable-identity design", "_origin": "semantic"}, {"id": "docs_adr_0014_memory_versions_copy_links_memory_version_row", "label": "Memory version row (supersedes_id)", "file_type": "concept", "source_file": "docs/adr/0014-memory-versions-copy-links.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One row per version; no supersedes link.", "_origin": "semantic"}, {"id": "docs_adr_0014_memory_versions_copy_links_link_copy_rule", "label": "Link copy rule on update", "file_type": "concept", "source_file": "docs/adr/0014-memory-versions-copy-links.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Copy incoming and outgoing depends_on links to new version; snapshot_of stays on old row.", "_origin": "semantic"}, {"id": "docs_adr_0014_memory_versions_copy_links_history_link", "label": "History link", "file_type": "concept", "source_file": "docs/adr/0014-memory-versions-copy-links.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A link whose parent is superseded; hidden from inspector and retrieval expansion.", "_origin": "semantic"}, {"id": "docs_adr_0014_memory_versions_copy_links_atomic_update", "label": "Atomic update transaction", "file_type": "concept", "source_file": "docs/adr/0014-memory-versions-copy-links.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "New row, retire old, copy links in one transaction; guarded by fail-mid-update test.", "_origin": "semantic"}], "edges": [{"source": "docs_adr_0014_memory_versions_copy_links_decision", "target": "docs_adr_0014_memory_versions_copy_links_memory_version_row", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0014-memory-versions-copy-links.md", "source_location": null, "weight": 1.0, "_origin": "semantic"}, {"source": "docs_adr_0014_memory_versions_copy_links_decision", "target": "docs_adr_0014_memory_versions_copy_links_link_copy_rule", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0014-memory-versions-copy-links.md", "source_location": null, "weight": 1.0, "_origin": "semantic"}, {"source": "docs_adr_0014_memory_versions_copy_links_decision", "target": "docs_adr_0014_memory_versions_copy_links_history_link", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0014-memory-versions-co