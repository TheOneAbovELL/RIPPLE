{"nodes": [{"id": "docs_proposals_0001_rule_first_resolution", "label": "Proposal 0001: Rule-first resolution", "file_type": "document", "source_file": "docs/proposals/0001-rule-first-resolution.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Status proposed, Tier B, 2026-10-19; later accepted as ADR-0019.", "_origin": "semantic"}, {"id": "docs_proposals_0001_rule_first_resolution_problem_llm_for_arithmetic", "label": "Problem: eligibility arithmetic sent to the LLM", "file_type": "concept", "source_file": "docs/proposals/0001-rule-first-resolution.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Eligibility, batch match and deadline reminders are arithmetic over structured fields; an LLM call per affected memory costs and risks mistakes, and makes the check-everything baseline look cheaper relative to Ripple than it should (C4).", "_origin": "semantic"}, {"id": "docs_proposals_0001_rule_first_resolution_rulefirst_rationale", "label": "Rationale: fewer LLM calls and deterministic testable decisions", "file_type": "concept", "source_file": "docs/proposals/0001-rule-first-resolution.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CGPA or deadline changes touch many eligibility beliefs; deterministic decisions need no FakeLLM scripts.", "_origin": "semantic"}, {"id": "docs_proposals_0001_rule_first_resolution_alternatives_rejected", "label": "Alternatives: LLM-only, calculator tool, rules in the Linker", "file_type": "concept", "source_file": "docs/proposals/0001-rule-first-resolution.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "LLM-only pays per memory; a calculator tool is still one call per memory; the Linker finds links and does not decide values (wrong layer).", "_origin"