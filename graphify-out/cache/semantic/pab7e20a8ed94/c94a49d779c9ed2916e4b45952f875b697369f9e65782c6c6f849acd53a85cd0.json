{"nodes": [{"id": "docs_adr_0030_opening_representation_decision", "label": "ADR-0030: An opening is one anchor memory plus one structured fact per field", "file_type": "rationale", "source_file": "docs/adr/0030-opening-representation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ripple engine propagates only along links between memories and rules only read StructuredFact triples. One memory per JD would make a deadline change an LLM-interpreted prose edit; fields without grouping can't be forgotten as a unit. record_opening writes one anchor memory (kind opening) plus a field fact per parsed field linked field--depends_on_fact-->anchor, all in one transaction with one ChangeEvent; OpeningFieldRule keeps/retires fields deterministically; stable opening_key survives versioning; one live opening per source.", "tradeoffs": "Rejected: one memory per JD with dict structured; N+1 ChangeEvents per JD (not atomic, noisy); anchor depends on fields (orphans on forget); no ChangeEvent at all (inconsistent). Cost: one deterministic keep wave per JD; multi-valued required_skill facts conflict with Intake same-subject+attribute update rule (raised as contract question).", "status": "Accepted under the autonomous mandate (WS-1)", "date": "2026-10-19", "revisit_if": "Scout re-fetches openings often enough that diffing fields into updates becomes the main write path", "_origin": "semantic"}, {"id": "docs_adr_0030_opening_representation_record_opening", "label": "record_opening", "file_type": "concept", "source_file": "docs/adr/0030-opening-representation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Writes anchor and field facts atomically.", "_origin": "semantic"}, {"id": "docs_adr_0030_opening_representation_anchor_memory", "label": "Opening anchor memory", "file_type": "concept", "source_file": "docs/adr/0030-opening-representation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Kind opening, content = one-line summary; field facts depend on it.", "_origin": "semantic"}, {"id": "docs_adr_0030_opening_representation_field_fact", "label": "Opening field fact", "file_type": "concept", "source_file": "docs/adr/0030-opening-representation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Kind fact, subject opening:<anchor id>, content = exact JD span.", "_origin": "semantic"}, {"id": "docs_adr_0030_opening_representation_openingfieldrule", "label": "OpeningFieldRule (ADR-0031)", "file_type": "concept", "source_file": "docs/adr/0030-opening-representation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keeps field if anchor VALID, retires if anchor RETIRED; no LLM.", "_origin": "semantic"}, {"id": "docs_adr_0030_opening_representation_opening_key", "label": "Stable opening key", "file_type": "concept", "source_file": "docs/adr/0030-opening-representation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "structured=(opening:<first version id>, opening_key, source_ref) survives edits; added after WS-1 code review blocker B2.", "_origin": "semantic"}, {"id": "docs_adr_0030_opening_representation_parsedopening", "label": "ParsedOpening (contract C1)", "file_type": "concept", "source_file": "docs/adr/0030-opening-representation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Parsed JD with summary and fields with character spans.", "_origin": "semantic"}, {"id": "docs_adr_0030_opening_representation_depends_on_fact", "label": "depends_on_fact link type", "file_type": "concept", "source_file": "docs/adr/0030-opening-representation.md", "source_