{"nodes": [{"id": "docs_adr_0026_retrieval_lexical_first_embedder_contract_decision", "label": "ADR-0026: Retrieval is lexical-first behind an Embedder contract; dense model decided at integration", "file_type": "rationale", "source_file": "docs/adr/0026-retrieval-lexical-first-embedder-contract.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Validity-aware hybrid retrieval with graph expansion and evidence citations (I1, FR-10). BGE-M3 locally means PyTorch and a multi-GB download on a no-GPU Windows machine. ripple.core.retrieval_contract fixes Retriever and Embedder; ripple.retrieval ships lexical path (Postgres FTS / in-memory scorer), one-hop graph expansion, evidence refs, dense path via any Embedder; production Embedder chosen at Phase 3 after measured comparison on RippleBench v0.", "tradeoffs": "Rejected deciding BGE-M3 now (commits gigabytes before metrics), hosted embeddings only (vendor dependency; kept as candidate b), dense-only (exact tokens matter; hybrid standard). Cost: H2 measurable on lexical path immediately; Embedder decision gets own ADR.", "status": "Accepted (autonomous mandate)", "date": "2026-10-19", "revisit_if": "Lexical recall on jobs track is so low that H2 cannot be assessed without dense retrieval", "_origin": "semantic"}, {"id": "docs_adr_0026_retrieval_lexical_first_embedder_contract_retrieval_contract", "label": "ripple.core.retrieval_contract", "file_type": "concept", "source_file": "docs/adr/0026-retrieval-lexical-first-embedder-contract.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Defines Retriever.search and Embedder interfaces.", "_origin": "semantic"}, {"id": "docs_adr_0026_retrieval_lexical_first_embedder_contract_ripple_retrieval", "label": "ripple.retrieval", "file_type": "concept", "source_file": "docs/adr/0026-retrieval-lexical-first-embedder-contract.md", "source_locatio