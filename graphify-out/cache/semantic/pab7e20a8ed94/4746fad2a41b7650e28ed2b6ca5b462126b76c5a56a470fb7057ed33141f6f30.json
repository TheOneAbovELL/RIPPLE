{"nodes": [{"id": "docs_proposals_0002_silver_labels_and_candidate_prefilter", "label": "Proposal 0002: Silver labels and candidate pre-filter for the link finder", "file_type": "document", "source_file": "docs/proposals/0002-silver-labels-and-candidate-prefilter.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Status proposed, 2026-10-19, Tier B. Recommendation: do later in Phase 4 when training-data generation starts; decide embedding ADR first.", "_origin": "semantic"}, {"id": "docs_proposals_0002_silver_labels_and_candidate_prefilter_silver_labels_from_structure", "label": "Structure-derived silver labels", "file_type": "rationale", "source_file": "docs/proposals/0002-silver-labels-and-candidate-prefilter.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Where both memories carry structured fields (FR-2 spans, profile subject/attribute/value), links like eligibility_of and criteria_from are derivable by rule: free and exact. LLM labelling reserved for hidden links (depends_on_fact between prose memories). Provenance recorded per pair. Alternative rejected: LLM labels for everything (known cost, unknown quality). Risk: model learns the rules not hidden links; mitigated by stratified evaluation per provenance.", "_origin": "semantic"}, {"id": "docs_proposals_0002_silver_labels_and_candidate_prefilter_candidate_prefilter", "label": "Candidate pre-filter before pair classifier", "file_type": "rationale", "source_file": "docs/proposals/0002-silver-labels-and-candidate-prefilter.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pair classification over all memories is quadratic (500 model calls per new opening). Keep only pairs sharing a subject or entity, plus top-k embedding neighbours, plus all profile facts. Makes write-time linking affordable at pilot scale. Risk: pre-filter recall caps link recall (ADR-0003 revisit condition); measured against labelled set. Rejected: no pre-filter with batching (still quadratic); embedding similarity as linker (similarity is not dependency, ADR-0009).", "_origin": "semantic"}, {"id": "docs_proposals_0002_silver_labels_and_candidate_prefilter_active_learning_from_corrections", "label": "Active learning from pilot corrections", "file_type": "rationale", "source_file": "docs/proposals/0002-silver-labels-and-candidate-prefilter.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pilot corrections enter training with uncertainty sampling: pairs scored near 0.5 are shown first in the inspector.", "_origin": "semantic"}, {"id": "docs_proposals_0002_silver_labels_and_candidate_prefilter_hand_checked_label_set", "label": "300 hand-checked label pairs (ADR-0009)", "file_type": "concept", "source_file": "docs/proposals/0002-silver-labels-and-candidate-prefilter.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ADR-0009 plans thousands of LLM-labelled pairs with 300 hand-checked; used to measure silver-label agreement by provenance and pre-filter recall.", "_origin": "semantic"}], "edges": [{"source": "docs_proposals_0002_silver_labels_and_candidate_prefilter", "target": "docs_proposals_0002_silver_labels_and_candidate_prefilter_silver_labels_from_structure", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/proposals/0002-silver-labels-and-candidate-prefilter.md", "source_location": null, "weight": 1.0, "_origin": "semantic"}, {"source": "docs_proposals_0002_silver_labels_and_candidate_prefilter", "target": "docs_proposals_0002_silver_labels_and_candidate_prefilter_candidate_prefilter", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_f