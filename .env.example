DATABASE_URL=postgresql+psycopg://ripple:change-me@localhost:5432/ripple
REDIS_URL=redis://localhost:6379/0
ANTHROPIC_API_KEY=
RIPPLE_LLM_CONFIG=config/llm.default.toml
OPENAI_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
TELEGRAM_BOT_TOKEN=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
# Development only: let `next dev` on :3000 call the API (comma-separated origins).
RIPPLE_CORS_ORIGINS=
# Scout (ADR-0070): the allowed-sources registry.
RIPPLE_SOURCES_CONFIG=config/sources.yaml

# --- production only (infra/docker-compose.prod.yml, ADR-0029) ---
RIPPLE_IMAGE=ghcr.io/<owner>/ripple:<tag>
RIPPLE_DOMAIN=ripple.example.edu
ACME_EMAIL=you@example.edu
POSTGRES_PASSWORD=change-me-with-a-long-random-value
TELEGRAM_WEBHOOK_SECRET=change-me-with-a-long-random-value
# Where the bot's /export points (the dashboard's account page).
RIPPLE_DASHBOARD_URL=https://ripple.example.edu/account
# MCP server (ADR-0080..0082); RIPPLE_MCP_TOKEN only for a local stdio client.
RIPPLE_MCP_PORT=8765
RIPPLE_MCP_TOKEN=
BACKUP_RETENTION_DAYS=30
BACKUP_S3_URL=
